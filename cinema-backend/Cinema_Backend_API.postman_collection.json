{
  "info": {
    "_postman_id": "cinema-backend-api-collection",
    "name": "Cinema Backend API",
    "description": "Postman collection for the Cinema QR Ordering Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "qrToken",
      "value": "test-token"
    },
    {
      "key": "theatreId",
      "value": "test-theatre-id"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "QR Seat Resolution",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/public/seat/{{qrToken}}"
      }
    },
    {
      "name": "Theatre Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/public/menu/{{theatreId}}"
      }
    }
  ]
}